# API environment variables — copy to apps/api/.env and fill in.
# Validated by Zod on boot (apps/api/src/config/env.validation.ts).
# Invalid env exits the process.

# ─── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (Postgres) ─────────────────────────────────────
# Local dev: docker-compose maps Postgres to 5433
# Production: use Supabase Transaction pooler URL
DATABASE_URL="postgresql://ticketbot:ticketbot@localhost:5433/ticketbot?schema=public"

# ─── Redis (BullMQ — currently stubbed but required) ─────────
# Local dev: docker-compose maps Redis to 6380
# Production: Railway Redis add-on or Upstash
REDIS_URL="redis://localhost:6380"

# ─── Supabase ────────────────────────────────────────────────
# From Supabase project Settings → API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
# Service role key — backend ONLY, never put in NEXT_PUBLIC_*
# Used by users.service.ts for the provisioning saga
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── Bot session JWT (HS256) ─────────────────────────────────
# Min 32 chars random. Generate with: openssl rand -base64 48
JWT_SECRET="generate-a-random-32-plus-char-secret-here"

# ─── Telegram Bot ────────────────────────────────────────────
# From @BotFather. Use a SEPARATE bot for production vs dev.
BOT_TOKEN="000000000:placeholder-bot-token-from-botfather"
TELEGRAM_BOT_USERNAME="dernek_organizer_bot"

# ─── Public URLs ─────────────────────────────────────────────
# API_URL must be publicly reachable in production — the bot
# uses this to register the Telegram webhook on boot.
# Localhost values keep the bot in long-polling mode for dev.
API_URL="http://localhost:3000"
WEB_URL="http://localhost:3001"

# ─── AI (Generic — Groq, OpenAI, DeepInfra, OpenRouter) ──────
# Primary key — works with any provider
AI_API_KEY="your-ai-api-key-here"

# Provider preset: groq | openai | deepinfra | openrouter
AI_PROVIDER_TYPE="groq"

# Optional overrides (if not set, preset defaults are used)
# AI_PROVIDER_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"
AI_TEMPERATURE=0.85
AI_MAX_TOKENS=2048

# Backward compatibility — fallback if AI_API_KEY not set
# GROQ_API_KEY="gsk_your-groq-api-key-here"

# ─── Email (Brevo — free tier: 300/day, ~9,000/month) ─────
# API key from https://app.brevo.com/settings/keys/api
# Sender email must be verified in Brevo dashboard
BREVO_API_KEY="xkeysib-your-brevo-api-key-here"
BREVO_FROM_EMAIL="zeyneloglumuhammetcan@gmail.com"
BREVO_FROM_NAME="Dernek Yönetim Sistemi"
